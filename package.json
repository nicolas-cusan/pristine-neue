{
  "name": "pristine-neue",
  "version": "1.1.10",
  "description": "A tiny vanilla javascript form validation library",
  "main": "dist/pristine.umd.cjs",
  "module": "dist/pristine.js",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vite build",
    "build:docs": "vitepress build docs",
    "build:all": "npm run build && npm run build:docs",
    "preview": "vitepress preview docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolas-cusan/pristine-neue.git"
  },
  "keywords": [
    "vanilla",
    "form",
    "validation",
    "micro",
    "tiny"
  ],
  "author": "Nicolas Cusan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nicolas-cusan/pristine-neue/issues"
  },
  "homepage": "https://github.com/nicolas-cusan/pristine-neue#readme",
  "devDependencies": {
    "@vitest/coverage-v8": "^1.3.1",
    "jsdom": "^24.0.0",
    "vite": "^5.4.10",
    "vitepress": "^1.6.4",
    "vitest": "^1.3.1",
    "vue": "^3.5.13"
  }
}
